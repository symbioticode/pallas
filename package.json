{
  "name": "pallas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build packages/core packages/risk packages/execution",
    "typecheck": "tsc --build --dry packages/core packages/risk packages/execution",
    "pretest": "tsc --build packages/core packages/risk packages/execution",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
